---
import Link from './Link/Link.astro'

const today = new Date()
---

<footer
	class="mt-auto flex w-full flex-wrap items-center justify-center gap-x-5 gap-y-1 bg-slate-200 px-5 py-3 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
	<span>&copy; {today.getFullYear()} All rights reserved.</span>
	<span>
		<Link
			href={`https://astro.build`}
			rel={`nofollow prefetch`}
			title={`Site build with 🚀Astro`}
			text={`Astro`}
			icon={`ic:baseline-rocket-launch`}
			className="flex items-center justify-center transition-transform duration-200 ease-out hover:-translate-y-0.5"
		/>
	</span>
	<span>
		<Link
			href={`https://www.ndeyros.dev/rss.xml`}
			rel={`nofollow prefetch`}
			title={`Nicolás Deyros Blog RSS Feed`}
			text={`RSS Feed`}
			icon={`ic:baseline-rss-feed`}
			className="flex items-center justify-center transition-transform duration-200 ease-out hover:-translate-y-0.5"
		/>
	</span>
</footer>
