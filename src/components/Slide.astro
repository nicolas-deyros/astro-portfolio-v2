---
interface Props {
	title: string
}

const { title } = Astro.props
---

<article
	aria-roledescription="slide"
	class="slide flex w-full shrink-0 snap-center flex-col rounded-lg border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
	<h3 class="mb-4 text-xl font-bold text-slate-900 dark:text-slate-100">
		{title}
	</h3>
	<div class="prose dark:prose-invert dark:prose-p:text-slate-300 max-w-none">
		<slot />
	</div>
</article>

<style>
	.slide {
		counter-increment: slide;
	}
	.slide::after {
		content: counter(slide);
		margin-top: auto;
		align-self: flex-end;
		font-size: 0.875rem;
		opacity: 0.6;
	}
</style>
