---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
	title: string
	image: ImageMetadata
	alt: string
}

const { title, image, alt } = Astro.props
---

<article
	aria-roledescription="slide"
	class="slide w-full shrink-0 snap-center overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800">
	<Image
		src={image}
		alt={alt}
		widths={[688, 1376]}
		sizes="(min-width: 768px) 768px, 100vw"
		class="h-auto w-full"
	/>
	<div class="flex items-center justify-between gap-4 px-4 py-2">
		<h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
			{title}
		</h3>
	</div>
</article>

<style>
	.slide {
		counter-increment: slide;
	}
	.slide div::after {
		content: counter(slide);
		font-size: 0.875rem;
		opacity: 0.6;
	}
</style>
