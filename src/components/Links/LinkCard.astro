---
import type { LinkData } from '@/types/links'

interface Props {
	link: LinkData
	getTagColor: (tag: string) => string
	index?: number
}

const { link, getTagColor, index = 0 } = Astro.props

const tags = link.tags
	? Array.isArray(link.tags)
		? link.tags
		: link.tags.split(',').map((tag: string) => tag.trim())
	: []
---

<article
	class="article-animate link-item flex w-full max-w-4xl flex-col gap-3 border-b-2 border-slate-200 p-1 pb-4 dark:border-slate-700"
	style={`animation-delay: ${index * 100}ms`}
	data-link-id={link.id}>
	{
		link.image && (
			<img
				src={link.image}
				alt=""
				loading="lazy"
				class="h-40 w-full rounded-md object-cover sm:h-56"
			/>
		)
	}

	<div class="flex flex-col gap-1">
		<div class="flex items-center justify-between gap-2">
			<h4 class="mb-1 text-xs font-bold text-slate-900 md:text-lg dark:text-slate-100">
				<a
					href={link.url}
					target="_blank"
					rel="noopener noreferrer"
					class="truncate transition-colors hover:text-blue-600 hover:underline dark:hover:text-blue-400">
					{link.title}
				</a>
			</h4>
			<span class="hidden md:block">-</span>
			<time
				class="text-xs text-slate-500 dark:text-slate-400"
				datetime={new Date(link.date).toISOString()}>
				{
					new Date(link.date).toLocaleDateString('en-us', {
						year: '2-digit',
						month: 'short',
						day: 'numeric',
					})
				}
			</time>
		</div>

		{
			tags.length > 0 && (
				<div class="flex flex-wrap justify-start gap-2">
					{tags.map((tag: string) => (
						<span
							class={`inline-flex items-center justify-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset ${getTagColor(tag)}`}>
							{tag}
						</span>
					))}
				</div>
			)
		}

		{
			link.description && (
				<p class="text-sm text-slate-600 dark:text-slate-300">
					{link.description}
				</p>
			)
		}

		<div class="mt-1 flex items-center gap-4">
			<button
				type="button"
				class="like-button flex items-center gap-1.5 text-sm text-slate-500 transition-colors hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400"
				data-link-id={link.id}
				aria-pressed="false"
				aria-label="Like this link">
				<svg
					class="like-icon h-4 w-4"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
					></path>
				</svg>
				<span class="like-count">{link.likes}</span>
			</button>

			<button
				type="button"
				class="share-button flex items-center gap-1.5 text-sm text-slate-500 transition-colors hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400"
				data-link-url={link.url}
				data-link-title={link.title}
				aria-label="Share this link">
				<svg
					class="h-4 w-4"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z"
					></path>
				</svg>
				<span class="share-label">Share</span>
			</button>
		</div>
	</div>
</article>

<script>
	document.addEventListener('astro:page-load', () => {
		const LIKED_KEY = 'liked-links'

		function getLikedIds(): string[] {
			try {
				const raw = localStorage.getItem(LIKED_KEY)
				return raw ? JSON.parse(raw) : []
			} catch {
				return []
			}
		}

		function setLiked(id: string) {
			try {
				const liked = getLikedIds()
				if (!liked.includes(id)) {
					liked.push(id)
					localStorage.setItem(LIKED_KEY, JSON.stringify(liked))
				}
			} catch {
				// localStorage unavailable (private mode etc.) — like still counts
				// server-side, just won't be remembered client-side.
			}
		}

		function unsetLiked(id: string) {
			try {
				const liked = getLikedIds().filter(existing => existing !== id)
				localStorage.setItem(LIKED_KEY, JSON.stringify(liked))
			} catch {
				// see above
			}
		}

		const likedIds = getLikedIds()

		document.querySelectorAll<HTMLButtonElement>('.like-button').forEach(button => {
			const id = button.dataset.linkId
			if (!id) return

			if (likedIds.includes(id)) {
				button.setAttribute('aria-pressed', 'true')
				button.classList.add('text-rose-600', 'dark:text-rose-400')
			}

			button.addEventListener('click', async () => {
				if (button.getAttribute('aria-pressed') === 'true') return

				const countEl = button.querySelector('.like-count')
				const previousCount = countEl ? parseInt(countEl.textContent || '0') : 0

				button.setAttribute('aria-pressed', 'true')
				button.classList.add('text-rose-600', 'dark:text-rose-400')
				if (countEl) countEl.textContent = String(previousCount + 1)
				setLiked(id)

				try {
					const res = await fetch('/api/links/like.json', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ id: Number(id) }),
					})
					if (!res.ok) throw new Error('Like request failed')
					const data = await res.json()
					if (countEl && typeof data.likes === 'number') {
						countEl.textContent = String(data.likes)
					}
				} catch {
					// Roll back on failure.
					button.setAttribute('aria-pressed', 'false')
					button.classList.remove('text-rose-600', 'dark:text-rose-400')
					if (countEl) countEl.textContent = String(previousCount)
					unsetLiked(id)
				}
			})
		})

		document.querySelectorAll<HTMLButtonElement>('.share-button').forEach(button => {
			button.addEventListener('click', async () => {
				const url = button.dataset.linkUrl
				const title = button.dataset.linkTitle
				if (!url) return

				const label = button.querySelector('.share-label')

				if (navigator.share) {
					try {
						await navigator.share({ title, url })
						return
					} catch {
						// User cancelled the share sheet — no fallback needed.
						return
					}
				}

				try {
					await navigator.clipboard.writeText(url)
					if (label) {
						const original = label.textContent
						label.textContent = 'Copied!'
						setTimeout(() => {
							label.textContent = original
						}, 1500)
					}
				} catch {
					// Clipboard API unavailable — nothing more we can do silently.
				}
			})
		})
	})
</script>

<style>
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.article-animate {
		opacity: 0;
		animation: fadeInUp 0.6s forwards;
	}
</style>
