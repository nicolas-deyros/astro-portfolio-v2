#!/usr/bin/env sh

echo "🚀 Running pre-push checks..."

# Run the simplified pre-push script from package.json
# This includes:
# 1. Type checking (astro check)
# 2. Critical unit tests (grammar, mdx, seo)
npm run test:critical

if [ $? -ne 0 ]; then
  echo "❌ Pre-push checks failed. Push aborted."
  echo "💡 Fix the errors above or use --no-verify to bypass (not recommended)."
  exit 1
fi

echo "✅ All checks passed! Pushing to remote..."