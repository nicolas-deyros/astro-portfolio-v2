# Copy to .env.local and fill in real values. Never commit .env.local.

# Turso (Drizzle ORM database)
ASTRO_DB_REMOTE_URL=
ASTRO_DB_APP_TOKEN=

# Email (React Email + Resend)
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_EMAIL=

# Admin auth
API_SECRET_KEY=

# Vercel Blob (link images, client portal files)
# Required for local dev image uploads to work — Vercel does not scope a
# Production/Preview env var to Development automatically. Add it to the
# Development environment in the Vercel dashboard (Storage > your Blob store)
# or via `vercel env add BLOB_READ_WRITE_TOKEN development`, then
# `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Injected automatically at runtime on Vercel; only needed locally if you rely
# on OIDC instead of BLOB_READ_WRITE_TOKEN.
VERCEL_OIDC_TOKEN=
