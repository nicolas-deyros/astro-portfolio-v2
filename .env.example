# Copy to .env.local and fill in real values. Never commit .env.local.

# Turso (Drizzle ORM database)
ASTRO_DB_REMOTE_URL=
ASTRO_DB_APP_TOKEN=

# Email (React Email + Resend)
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_EMAIL=

# Admin auth
API_SECRET_KEY=

# Vercel Blob — PRIVATE store, client portal files only. Vercel doesn't allow
# mixing public/private access within one store, so this one must stay
# private; see BLOB_LINKS_IMAGES_* below for the public link-images store.
# Required for local dev uploads to work — Vercel does not scope a
# Production/Preview env var to Development automatically. Add it to the
# Development environment in the Vercel dashboard (Storage > your Blob store)
# or via `vercel env add BLOB_READ_WRITE_TOKEN development`, then
# `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Vercel Blob — PUBLIC store, link card images only (shown to any visitor on
# /links and in the RSS feed). Connected via the dashboard's "Connect to
# Project" flow with prefix "BLOB_LINKS_IMAGES" to avoid colliding with the
# private store's env var names above.
BLOB_LINKS_IMAGES_READ_WRITE_TOKEN=
BLOB_LINKS_IMAGES_STORE_ID=

# Injected automatically at runtime on Vercel; only needed locally if you rely
# on OIDC instead of a *_READ_WRITE_TOKEN.
VERCEL_OIDC_TOKEN=
